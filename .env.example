# Auth.js / NextAuth (Google Sign-In only)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# AI writer — OpenRouter preferred (unrestricted resume + cover letter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional Anthropic fallback if OpenRouter is unset
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional Jev / TypeSafe decision layer
TYPESAFE_API_KEY=

# Optional Razorpay for Buy me a coffee ($1 USD min)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
